// =============================================================
// prisma/schema.prisma
// Prisma v7 : la connexion DB n'est PLUS déclarée ici
// Elle est dans prisma.config.ts
// =============================================================

generator client {
  provider = "prisma-client-js"
}

// ✅ Prisma v7 : datasource sans "url", la connexion passe par prisma.config.ts
datasource db {
  provider = "postgresql"
}

enum Role {
  attendee
  organizer
}

model User {
  id        String   @id @default(uuid())
  nom       String
  prenom    String
  email     String   @unique
  password  String
  role      Role     @default(attendee)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}